# 腾讯云 COS upload provider (read by the Electron main process).
# When all four COS_* values are set, file-field uploads go to COS and the
# resulting URL is written into the JSON. When unset, uploads fall back to the
# app data directory and the written value is a file:// URL.
#
# Place this file either:
#   - dev:   in the project root (next to package.json)
#   - prod:  next to the installed executable, or in the app's userData dir
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket-1234567890

# Optional: key prefix inside the bucket (default: json-editor)
# COS_PREFIX=json-editor

# Optional: public base URL override (e.g. CDN domain). Defaults to
# https://<bucket>.cos.<region>.myqcloud.com — requires the bucket/object to be
# publicly readable if unset.
# COS_PUBLIC_BASE=
